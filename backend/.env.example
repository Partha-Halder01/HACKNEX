# Copy to backend/.env and fill in. Never commit the real .env.
ENVIRONMENT=development
FRONTEND_ORIGIN=http://localhost:5173

# MongoDB (optional; without it analysis runs and field checks are not stored in a DB)
MONGODB_URI=
MONGODB_DATABASE=sundarban_blue_carbon

# Google Earth Engine — set GEE_ENABLED=true to switch the dashboard from demo to live data
GEE_ENABLED=false
GEE_PROJECT_ID=
GEE_SERVICE_ACCOUNT=
# Either a path to the service-account JSON key...
GEE_PRIVATE_KEY_FILE=
# ...or the JSON itself as one line (for hosted environments)
GEE_PRIVATE_KEY_JSON=

# CGMD reference labels (check band names in the GEE Code Editor first)
CGMD_ASSET_ID=projects/mangrovedatahub2/assets/CGMD-AFCC30
CGMD_ASSET_TYPE=image_bands
CGMD_BAND_PATTERN=year_{year}
CGMD_MANGROVE_VALUE=1

# Gemini (optional; only rewords the summary, numbers are validated)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
