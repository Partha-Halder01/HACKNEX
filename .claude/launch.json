{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "backend",
      "runtimeExecutable": "python",
      "runtimeArgs": [
        "backend/run.py"
      ],
      "port": 8000
    },
    {
      "name": "frontend",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "frontend"
      ],
      "port": 5173
    },
    {
      "name": "backend-test",
      "runtimeExecutable": "backend/.venv/Scripts/python.exe",
      "runtimeArgs": [
        "-m",
        "uvicorn",
        "app.main:app",
        "--app-dir",
        "backend",
        "--port",
        "8001"
      ],
      "port": 8001
    },
    {
      "name": "frontend-test",
      "runtimeExecutable": "cmd",
      "runtimeArgs": [
        "/c",
        "set API_PROXY_TARGET=http://127.0.0.1:8001&& npx vite --port 5174 --strictPort"
      ],
      "port": 5174
    }
  ]
}
